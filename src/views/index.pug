extends index_body

block content
  div.container-fluid.p-0
    img.custom-index-wh(src= index.background, alt="index background")
  div.container-fluid.custom-index-wh.custom-index-div-overlay.d-flex.justify-content-center.align-items-center
    div.text-center
      h1.text-light.custom-text-shadow-2px!= index.title
      h1.text-light.custom-text-shadow-1px.mt-3!= index.subtitle
      div.mt-5
        each linkitem in index.links
          if (linkitem.href == '') || (linkitem.href == '###')
            span.custom-index-link.text-secondary.ml-3.mr-3= linkitem.title
          else
            a.custom-index-link.custom-text-shadow-1px.ml-3.mr-3(href= `./${linkitem.href}.html`)= linkitem.title
      div.text-left.mt-5.p-3
        each logitem, id in logs
          if (id < 5)
            a.text-white(href= `./${logitem.id}.html`)
              div.mt-1.mb-1.mt-lg-3.mb-lg-3!= `${logitem.date} ${logitem.message}`

block footer-scripts
