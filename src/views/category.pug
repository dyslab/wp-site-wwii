extends body

block content
  section#cat.custom-category-style.pt-5.pb-5
    div.container
      //- 国旗导航
      nav.nav.justify-content-center
        each linkitem in body.countries
          if linkitem.href == '' || linkitem.href == '###'
            a.nav-link.disabled(href="#", tabindex="-1", aria-disabled="true", title=linkitem.name)
              img.rounded.custom-category-img-actived(src=linkitem.image, alt=linkitem.name) 
          else
            a.nav-link(href=linkitem.href, title=linkitem.name)
              img.rounded.custom-category-img-link(src=linkitem.image, alt=linkitem.name)
      //- 内容
      div.row.mt-3
        each item in body.weapons
          if item.intro == '###'
            div.col-12.mt-3.mb-3(id=item.link)
              h5.font-weight-bold.custom-text-shadow-1px #{item.model}
          else
            div.col-12.col-lg-6.mb-3
              a(href=item.link + '.html')
                div.card
                  img.card-img-top(src=item.image, alt=item.model)
                  div.card-body
                    h5.card-title.font-weight-bold.custom-text-shadow-1px #{item.model}
                    p.card-text!= item.intro

block footer-scripts
