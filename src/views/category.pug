extends body

block content
  section#cat.custom-category-style.pt-3.pb-3
    div.container
      div.row
        div.col-12.pt-3.pb-3
          nav.nav
            each linkitem in body.countries
              if linkitem.href == '' || linkitem.href == '###'
                a.nav-link.disabled(href="#", tabindex="-1", aria-disabled="true")= linkitem.name
              else
                a.nav-link(href=linkitem.href)= linkitem.name
      each item in body.weapons
        if item.intro == '###'
          div.row.pt-3.pb-3
            div.col-12.pt-3(id='#' + item.link)
              h5.font-weight-bold.custom-text-shadow-1px #{item.model}
        else
          a(href=item.link + '.html')
            div.row.pt-3.pb-3
              div.col-12.col-md-4.col-lg-5.pt-3
                img.img-fluid.rounded(src=item.image, alt=item.model)
              div.col-12.col-md-8.col-lg-7.pt-3
                h5.font-weight-bold.custom-text-shadow-1px #{item.model}
                span!= item.intro

block footer-scripts
  script.
    $(document).ready(function() {
    }
