extends body

block content
  section#doc.custom-document-style.pt-5.pb-5
    div.container
      nav(aria-label="breadcrumb")
        ol.breadcrumb.custom-document-style
          each catitem in body.category
            li.breadcrumb-item
              if catitem.link.search(/#/iu) >= 0
                a(href=catitem.link.replace(/#/iu, '.html#'))= catitem.name
              else
                a(href=catitem.link + '.html')= catitem.name
          li.breadcrumb-item.active(aria-current="page")=body.model
      div.row
        div.col.text-center
          span.h3.font-weight-bold.custom-text-shadow-2px= body.model
      div.row
        div.col
          div.p-3
          span.custom-document-content!= body.description
          div.p-3
      div.row
        div.col
          span.h3.custom-text-shadow-1px!= body.part1title
          div.p-3
      if body.part1description != ''
        div.row
          div.col
            span.custom-document-content!= body.part1description
            div.p-3
      each p1item in body.part1content
        div.row.pb-3
          div.col-lg-7.order-1.order-lg-0
            -
              toParse = p1item.image.indexOf('{{');
            if (toParse >= 0)
              -
                src = p1item.image;
                // Parsing...
                var pos = 0;
                var cmd_flag = false;
                var cmd_str = "";
                var tmp_str = "";
                var src_char = "";
                var result_array = [];
                while (pos < src.length) {
                  src_char =  src.charAt(pos);
                  switch (src_char) {
                    case "{":
                      pos++;
                      src_next_char = src.charAt(pos);
                      if (src_next_char === "{") {
                          cmd_flag = true;
                          // manipulate the previous command.
                          if (cmd_str !== "") {
                              result_array.push(
                                  {
                                      command: cmd_str.toLowerCase(),
                                      content: tmp_str
                                  }
                              );
                          }
                          cmd_str = "";
                          tmp_str = "";
                      } else {
                          if (cmd_flag) cmd_str += src_char + src_next_char;
                          else          tmp_str += src_char + src_next_char;
                      }
                      break;
                    case "}":
                      pos++;
                      src_next_char = src.charAt(pos);
                      if (src_next_char === "}") {
                          cmd_flag = false;
                      } else {
                          if (cmd_flag) cmd_str += src_char + src_next_char;
                          else          tmp_str += src_char + src_next_char;
                      }
                      break;
                    default:
                      if (cmd_flag) cmd_str += src_char;
                      else          tmp_str += src_char;
                      break;
                  }
                  pos++;
                }
                if (cmd_str !== "") {
                  result_array.push({ command: cmd_str, content: tmp_str });
                }
              each r1item in result_array
                if r1item.command == 'image'
                  img.img-fluid.rounded(src=r1item.content)
                else if r1item.command == 'text'
                  div.mt-3.mb-3
                    span.custom-document-content!= r1item.content
                else if r1item.command == 'caption'
                  div.mt-3.mb-3
                    span.custom-document-caption.text-secondary!= r1item.content
            else
              img.img-fluid.rounded(src=p1item.image)
              div.mt-3.mb-3
                span.custom-document-caption.text-secondary!= p1item.caption
          div.col-lg-5.order-0.order-lg-1
            span.custom-document-content!= p1item.description
      div.row
        div.col
          div.p-3
          span.h3.custom-text-shadow-1px!= body.part2title
          div.p-3
      if body.part2description != ''
        div.row
          div.col
            span.custom-document-content!= body.part2description
            div.p-3
      div.row.mfp-gallery
        each p2item in body.part2content
          div.col-md-6.pt-3
            div.card
              div.card-body
                div.card-img
                  a.mfp-image-link(href=p2item.image, title=p2item.description)
                    figure.figure
                      img.figure-img.img-fluid.rounded(src=p2item.image)
                      figcaption.figure-caption= p2item.caption
                span.card-text.custom-document-content!= p2item.description

block footer-scripts
  script(src="./common/js/jquery.magnific-popup.min.js")
  script.
    $(document).ready(function() {
      $(".mfp-image-link").magnificPopup({
        type: "image",
        closeOnContentClick: true,
        gallery: {
          enabled: true,
          preload: [0,2],
          navigateByImgClick: true
        }
      });
    });
