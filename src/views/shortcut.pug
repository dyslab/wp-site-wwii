extends body

block content
  section#shortcut.custom-shortcut-style.pt-3.pb-3
    div.container
      div.row
        div.col-12.pt-3.pb-3
          nav.nav.justify-content-center
            each linkitem in body.countries
              if linkitem.href == '' || linkitem.href == '###'
                a.nav-link.disabled(href="#", tabindex="-1", aria-disabled="true", title=linkitem.name)
                  img.rounded.custom-shortcut-img-actived(src=linkitem.image, alt=linkitem.name) 
              else
                a.nav-link(href=linkitem.href, title=linkitem.name)
                  img.rounded.custom-shortcut-img-link(src=linkitem.image, alt=linkitem.name) 
      div.row
        div.col.col-lg-10.pt-3.pb-3
          each item in body.weapons
            div.row.pt-2.pb-2
              if item.intro == '***'
                div.col.pt-2.pb-2
                  i.fas.fa-clipboard-list.fa-lg
                  |  
                  span.h5.font-weight-bold.custom-text-shadow-1px(id=item.link)= item.title
              else if item.intro == '###'
                div.col
                  i.fas.fa-ellipsis-h.fa-lg
                  |  
                  span.h5.font-weight-bold.custom-text-shadow-1px(id=item.link)= item.title
              else
                div.col-12.col-md-3.col-lg-2
                  a(href=item.link + '.html')
                    span.font-weight-bold= item.title
                div.col-12.col-md-9.col-lg-10
                  span!= item.intro
        div.d-none.d-lg-block.col-lg-2
          div.sticky-top.pt-3.pb-3
            div.list-group
              each item in body.weapons
                if item.intro == '***'
                  a.list-group-item.list-group-item-action.custom-shortcut-menu-color-1.pl-2.pt-1.pb-1.pr-1(href="#" + item.link)!= item.title
                else
                  if item.intro == '###'
                    a.list-group-item.list-group-item-action.custom-shortcut-menu-color-2.pl-3.pt-0.pb-0.pr-2(href="#" + item.link)!= item.title

block footer-scripts
