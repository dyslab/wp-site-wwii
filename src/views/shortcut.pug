extends body

block content
  section#about.custom-shortcut-style.pt-3.pb-3
    div.container
      div.row
        div.col-12.col-lg-10.pt-3.pb-3
          table.table.table-responsive
            each item in body
              if item.intro == '###'
                tr
                  th.thead-light.text-info(scope="col", colspan="2")
                    i.fas.fa-th-list.fa-lg
                    |  
                    span.h5.font-weight-bold.custom-text-shadow-1px(id=item.link) #{item.title}
              else
                tr
                  td
                    a(href=item.link + '.html')
                      span.font-weight-bold #{item.title}
                  td
                    span!= item.intro
        div.d-none.d-lg-block.col-lg-2
          div.sticky-top.pt-3.pb-3
            div.card.bg-light
              div.list-group.list-group-flush
                each item in body
                  if item.intro == '###'
                    a.list-group-item.list-group-item-action(href="#" + item.link)!= item.title

block footer-scripts
  script.
    $(document).ready(function() {
    }
