block footer-scripts
  script.
    $(document).ready(function() {


      $("#testBS").click(function() {
        var id = GetQueryString('id');
        alert("hello, Bootstrap/JQuery. GET query ID:" + id);
      });
      $("#testFunc").click(function() {
        var inp = parseInt(Math.random()*100);
        var ret = DoubleFuncProc(inp);
        alert("Input = " + inp + ",Result = " + ret);
      });
    });

    //- Function: GetQueryString from GET method.
    function GetQueryString(name) {
      let regstr = '(^|&)' + name + '=([^&]*)(&|$)';
      let reg = new RegExp(regstr);
      let r = window.location.search.substr(1).match(reg);
      if (r != null) { return  unescape(r[2]); } 
      return null;
    }
